# Create Ecco's own Firebase project (console.firebase.google.com), then copy
# its web app config here as .env.local. Without these, the site still works
# fully (menu, pages) — only the admin price editor / Firestore features need them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
